{
  "layer": "top",
  "position": "top",
  "height": 26,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": [
    "custom/logo",
    "wlr/workspaces",
    "mpris"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "pulseaudio",
    "bluetooth",
    "network",
    "battery",
    "tray"
  ],

  // --- custom modules ---

  "custom/logo": {
    "format": "ॐ",
    "tooltip": false
  },

  // --- core modules ---

  "wlr/workspaces": {
    "on-click": "hyprctl dispatch workspace {id}",
    "format": "{icon}",
    "format-icons": {
      "1": "α",
      "2": "β",
      "3": "γ",
      "4": "δ",
      "5": "ε"
    },
    "all-outputs": true
  },

  "clock": {
    "format": "{:%A: %H:%M  }",
    "interval": 30
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " {volume}%",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "kitty -e pulsemixer",
    "tooltip": false
  },

  "bluetooth": {
    "format": "{icon}",
    "format-connected": "",
    "format-disabled": "",
    "on-click": "kitty -e bluetuith",
    "tooltip": true
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈁",
    "format-disconnected": "󰖪",
    "tooltip": true
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip": true
  },

  "tray": {
    "icon-size": 14,
    "spacing": 6
  },
  "custom/screenshot": {
  "format": "",
  "tooltip": "Left: area (copy) | Middle: full (copy) | Right: area (save)",
  "on-click": "grimblast copy area",
  "on-click-middle": "grimblast copy output",
  "on-click-right": "grimblast save area ~/Pictures/Screenshots/",
  "signal": 0
},

}
