[global]
    ### Where to show notifications ###
    monitor = 0
    follow = none

    # Size & position (replaces old geometry)
    width = 300
    height = 80
    origin = top-right         # top-left, top-right, bottom-left, etc.
    offset = (10, 10)          # (x, y) from that corner

    ### Look & feel ###
    font = JetBrainsMono Nerd Font 11

    padding = 8
    horizontal_padding = 10
    separator_height = 1

    frame_width = 2
    frame_color = "#ff3737"    # red border
    separator_color = frame
    corner_radius = 12
    transparency = 5           # 0–100 (X11). On Wayland use RGBA colors for alpha.

    ### Icons ###
    icon_position = left
    max_icon_size = 32
    icon_theme = Papirus

    ### Behaviour ###
    history_length = 20
    sticky_history = yes
    show_indicators = true
    ignore_dbusclose = false
    always_run_script = true

    mouse_left_click = close_current
    mouse_middle_click = close_all
    mouse_right_click = do_action

[urgency_low]
    background = "#050505"
    foreground = "#b6ff00"     # lime
    frame_color = "#333333"
    timeout = 4

[urgency_normal]
    background = "#050505"
    foreground = "#b6ff00"     # lime
    frame_color = "#ff3737"    # red
    timeout = 6

[urgency_critical]
    background = "#050505"
    foreground = "#ff3737"     # red text
    frame_color = "#ff3737"
    timeout = 0                # sticky
