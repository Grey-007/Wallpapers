#!/usr/bin/env bash

PID_FILE="/tmp/gpu-screen-recorder.pid"
OUTPUT_DIR="$HOME/Videos/Recordings"
FPS=60
QUALITY="high"   # high | very_high | medium, etc.

mkdir -p "$OUTPUT_DIR"

# Get default desktop audio (PipeWire / Pulse)
if command -v pactl >/dev/null 2>&1; then
    AUDIO="$(pactl get-default-sink).monitor"
else
    AUDIO="default_output"
fi

MODE="$1"   # fullscreen | window | region | stop

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send "$1" "$2"
}

start_recording() {
    local winopt="screen"

    case "$MODE" in
        fullscreen|"")
            winopt="screen"      # all monitors
            ;;
        window|active)
            winopt="window"      # gpu-screen-recorder window picker
            ;;
        region)
            winopt="region"      # gpu-screen-recorder region picker
            ;;
        *)
            winopt="screen"
            ;;
    esac

    if ! command -v gpu-screen-recorder >/dev/null 2>&1; then
        notify "gpu-screen-recorder" "Not installed!"
        exit 1
    fi

    FILENAME="$OUTPUT_DIR/Recording_$(date '+%Y-%m-%d_%H-%M-%S').mp4"

    gpu-screen-recorder \
        -w "$winopt" \
        -f "$FPS" \
        -q "$QUALITY" \
        -a "$AUDIO" \
        -c mp4 \
        -o "$FILENAME" \
        >/dev/null 2>&1 &

    echo $! > "$PID_FILE"
    notify " Recording started" "Mode: $MODE → $FILENAME"
}

stop_recording() {
    if [[ -f "$PID_FILE" ]]; then
        pid=$(cat "$PID_FILE")
        if [[ -n "$pid" && -d "/proc/$pid" ]]; then
            kill -INT "$pid" 2>/dev/null
        fi
        rm -f "$PID_FILE"
        notify " Recording stopped" "Saved to $OUTPUT_DIR"
    else
        # Fallback if PID file got lost
        pkill -SIGINT gpu-screen-recorder 2>/dev/null
        notify " Recording stopped" "Fallback stop"
    fi
}

# If explicit "stop" mode is chosen, just stop
if [[ "$MODE" == "stop" ]]; then
    stop_recording
    exit 0
fi

# Toggle: if running -> stop, else -> start with chosen mode
if [[ -f "$PID_FILE" ]]; then
    stop_recording
else
    start_recording
fi
