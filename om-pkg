#!/usr/bin/env bash
# Omarchy-style package search using fzf + yay
# Instant search, preview, repo/AUR badges, theme-aware.

set -euo pipefail

HELPER="yay"  # your AUR helper

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/om-pkg"
PKG_CACHE="$CACHE_DIR/pkgs.tsv"
mkdir -p "$CACHE_DIR"

# ---------- DEFAULT COLORS (red / lime / grey) ----------

FZF_BG="#050608"       # near-black
FZF_BG_PLUS="#12141b"  # focused line bg
FZF_FG="#d0d0d0"       # main text
FZF_GREY="#6b6b6b"     # subtle labels/border
FZF_RED="#ff4b5c"      # accent red
FZF_LIME="#b4ff39"     # lime green

# ---------- LOAD COLORS FROM PYWAL / MATUGEN IF AVAILABLE ----------

load_theme_from_json() {
  local json="$1"
  command -v jq >/dev/null 2>&1 || return 0

  local bg fg red green
  bg=$(jq -r '.colors.color0 // empty' "$json" 2>/dev/null || true)
  fg=$(jq -r '.colors.color7 // empty' "$json" 2>/dev/null || true)
  red=$(jq -r '.colors.color1 // empty' "$json" 2>/dev/null || true)
  green=$(jq -r '.colors.color2 // empty' "$json" 2>/dev/null || true)

  [[ -n "${bg:-}" ]]    && FZF_BG="$bg"
  [[ -n "${fg:-}" ]]    && FZF_FG="$fg"
  [[ -n "${red:-}" ]]   && FZF_RED="$red"
  [[ -n "${green:-}" ]] && FZF_LIME="$green"
}

load_theme() {
  # 1) Pywal
  if [[ -f "${WAL_CACHE_JSON:-$HOME/.cache/wal/colors.json}" ]]; then
    load_theme_from_json "${WAL_CACHE_JSON:-$HOME/.cache/wal/colors.json}"
    return
  fi

  # 2) Matugen (adjust path if yours is different)
  if [[ -f "${MATUGEN_COLORS_JSON:-$HOME/.cache/matugen/colors.json}" ]]; then
    load_theme_from_json "${MATUGEN_COLORS_JSON:-$HOME/.cache/matugen/colors.json}"
    return
  fi
}

load_theme

FZF_COLORS=$(
  cat <<EOF
fg:${FZF_FG},bg:${FZF_BG},hl:${FZF_LIME},
fg+:${FZF_FG},bg+:${FZF_BG_PLUS},hl+:${FZF_LIME},
info:${FZF_GREY},prompt:${FZF_RED},pointer:${FZF_RED},
marker:${FZF_LIME},spinner:${FZF_RED},header:${FZF_GREY},border:${FZF_GREY}
EOF
)

# ---------- BUILD PACKAGE CACHE (REPO + AUR via yay) ----------

build_cache() {
  mkdir -p "$CACHE_DIR"
  # yay -Sl prints: "<repo> <name> <version> [desc...]"
  # If repo == aur -> tag as AUR, otherwise REPO.
  "$HELPER" -Sl --color=never 2>/dev/null \
    | awk '
      {
        repo=$1; name=$2; ver=$3;
        $1=$2=$3="";
        sub(/^  */, "");
        desc=$0;

        type = (repo == "aur") ? "AUR" : "REPO";
        if (desc == "") desc = "[" repo "]";

        printf "%s\t%s\t[%s] %s\n", type, name, repo, desc;
      }
    ' \
    | sort -u > "$PKG_CACHE" || true
}

# First-time / missing cache
if [[ ! -s "$PKG_CACHE" ]]; then
  echo "Building package cache (repo + AUR)..."
  build_cache
fi

# ---------- FZF UI ----------

run_fzf() {
  FZF_DEFAULT_OPTS="--ansi" \
  fzf \
    --ansi \
    --prompt="  Packages  " \
    --header=" ↑↓/TAB: select  •  Enter: choose  •  (rebuild cache: om-pkg --rebuild-cache) " \
    --layout=reverse \
    --border=rounded \
    --height=95% \
    --info=inline \
    --tabstop=4 \
    --color="$FZF_COLORS" \
    --delimiter=$'\t' \
    --with-nth=1,2,3 \
    --preview-window="right,60%,border-left" \
    --preview '
      kind={1}; pkg={2};
      echo "  " "$pkg" " [" kind "]";
      echo "";
      '"$HELPER"' -Qi "$pkg" 2>/dev/null ||
      '"$HELPER"' -Si "$pkg" 2>/dev/null ||
      pacman -Qi "$pkg" 2>/dev/null ||
      pacman -Si "$pkg" 2>/dev/null ||
      echo "No package info found."
    ' \
    <"$PKG_CACHE"
}

# ---------- ACTION MENU AFTER SELECTION ----------

actions_for_pkg() {
  local kind="$1" pkg="$2"

  printf "\nSelected: %s (%s)\n" "$pkg" "$kind"
  printf " [i] install   [r] remove   [I] info   [q] quit  → "
  read -r choice

  case "$choice" in
    ""|i)
      echo
      echo "Installing: $pkg"
      "$HELPER" -S "$pkg"
      ;;
    r)
      echo
      echo "Removing: $pkg"
      "$HELPER" -Rns "$pkg"
      ;;
    I|info)
      echo
      echo "Info for: $pkg"
      "$HELPER" -Qi "$pkg" 2>/dev/null ||
        "$HELPER" -Si "$pkg" 2>/dev/null ||
        pacman -Qi "$pkg" 2>/dev/null ||
        pacman -Si "$pkg" 2>/dev/null
      ;;
    q|*)
      echo "Aborted."
      ;;
  esac
}

# ---------- ENTRYPOINT ----------

if [[ "${1:-}" == "--rebuild-cache" ]]; then
  build_cache
  echo "Cache rebuilt at: $PKG_CACHE"
  exit 0
fi

selection="$(run_fzf || true)"

if [[ -z "$selection" ]]; then
  exit 0
fi

kind=$(printf '%s\n' "$selection" | awk -F'\t' '{print $1}')
pkg=$(printf '%s\n' "$selection" | awk -F'\t' '{print $2}')

actions_for_pkg "$kind" "$pkg"
